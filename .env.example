# Public Supabase project values. These are safe for the browser and still
# depend on Row Level Security for authorization.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-or-publishable-key

# Application origin used for OAuth and password-reset redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Never prefix this key with NEXT_PUBLIC_ or import it in client code.
# SUPABASE_SERVICE_ROLE_KEY=only-for-explicit-platform-admin-jobs
